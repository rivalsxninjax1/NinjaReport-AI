# NinjaReport AI configuration. Copy this file to .env and edit it.
# Never commit .env. Restart the app after changing it.

# --- Local AI (Ollama) ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Text model for evidence analysis, findings, and report narrative. It must already be
# pulled (for example: ollama pull llama3.1:8b-instruct-q4_K_M); the app never downloads models.
OLLAMA_TEXT_MODEL=
# Reserved for future screenshot-vision analysis. Not used yet.
OLLAMA_VISION_MODEL=
AI_TIMEOUT_SECONDS=180

# --- Storage ---
# Leave blank to use your operating system's standard app-data folder.
NINJAREPORT_DATA_DIR=
NINJAREPORT_EXPORT_DIR=

# --- Limits and switches ---
MAX_UPLOAD_MB=50
# Read but not enforced yet (OCR and PDF export always run when their tools are installed).
OCR_ENABLED=true
PDF_EXPORT_ENABLED=true
